ARG BASE_IMAGE=pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime
FROM ${BASE_IMAGE}

# 构建参数：默认使用国内镜像源（可在 docker build 时通过 --build-arg 覆盖）
ARG USE_CN_MIRRORS=1
ARG APT_MIRROR_HOST=mirrors.aliyun.com
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ARG INSTALL_TORCH_CPU=0

ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    if [ "${USE_CN_MIRRORS}" = "1" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
            [ -f "$f" ] || continue; \
            sed -i \
                -e "s@archive.ubuntu.com@${APT_MIRROR_HOST}@g" \
                -e "s@security.ubuntu.com@${APT_MIRROR_HOST}@g" \
                -e "s@deb.debian.org@${APT_MIRROR_HOST}@g" \
                -e "s@security.debian.org@${APT_MIRROR_HOST}@g" \
                "$f"; \
        done; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    if [ "${INSTALL_TORCH_CPU}" = "1" ]; then \
        pip install --no-cache-dir \
            "torch==2.3.1" \
            "torchaudio==2.3.1"; \
    fi

WORKDIR /opt

# 基础构建参数
ARG MODEL_ID=vibevoice-1.5b
ENV MODEL_ID=${MODEL_ID}
ENV MODELS_DIR=/models

# ModelScope 缓存写到临时目录，构建结束前清理，避免把 cache 打进镜像层导致不稳定/变大
ENV MODELSCOPE_CACHE=/tmp/modelscope-cache

# 模型权重下载尽量前置，避免后续调试依赖时反复下载大文件
COPY scripts/download_models.py /opt/scripts/download_models.py
RUN pip install --no-cache-dir "modelscope==1.33.0"
RUN python /opt/scripts/download_models.py; \
    rm -rf /tmp/modelscope-cache

# 再安装通用依赖和模型专属依赖
COPY requirements.txt /tmp/requirements.txt
RUN set -eux; \
    pip install --no-cache-dir -r /tmp/requirements.txt; \
    case "${MODEL_ID}" in \
      # model-block:start:vibevoice-1.5b
      "vibevoice-1.5b") \
        true; \
        ;; \
      # model-block:end:vibevoice-1.5b
      # model-block:start:vibevoice-7b
      "vibevoice-7b") \
        true; \
        ;; \
      # model-block:end:vibevoice-7b
      # model-block:start:cosyvoice3-0.5b
      "cosyvoice3-0.5b") \
        apt-get update; \
        apt-get install -y --no-install-recommends g++; \
        rm -rf /var/lib/apt/lists/*; \
        pip install --no-cache-dir \
          "conformer==0.3.2" \
          "diffusers==0.29.0" \
          "gdown==5.1.0" \
          "hydra-core==1.3.2" \
          "hyperpyyaml==1.2.3" \
          "inflect==7.3.1" \
          "librosa==0.10.2" \
          "lightning==2.2.4" \
          "matplotlib==3.7.5" \
          "numpy==1.26.4" \
          "omegaconf==2.3.0" \
          "onnx==1.16.0" \
          "pyarrow==18.1.0" \
          "pyworld==0.3.4" \
          "tiktoken==0.12.0" \
          "rich==13.7.1" \
          "torchaudio==2.3.1" \
          "transformers==4.51.3" \
          "wetext==0.0.4" \
          "wget==3.2" \
          "x-transformers==2.11.24"; \
        if [ "${INSTALL_TORCH_CPU}" = "1" ]; then \
          pip install --no-cache-dir "onnxruntime==1.18.0"; \
        else \
          # Keep ORT on CUDA12 + cuDNN8 to match pytorch:2.3.1-cuda12.1-cudnn8-runtime.
          # onnxruntime-gpu>=1.19 on CUDA12 requires cuDNN9 and fails with libcudnn.so.9 missing.
          pip install --no-cache-dir \
            --extra-index-url "https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/" \
            --extra-index-url "https://pypi.org/simple/" \
            "onnxruntime-gpu==1.18.0"; \
        fi; \
        pip install --no-cache-dir --no-build-isolation \
          "openai-whisper==20231117"; \
        ;; \
      # model-block:end:cosyvoice3-0.5b
      *) \
        echo "Unsupported MODEL_ID: ${MODEL_ID}"; \
        exit 1; \
        ;; \
    esac

# VibeVoice 文本 tokenizer 依赖 HuggingFace 缓存；在构建期预拉取，保证运行期离线模式可启动。
COPY scripts/download_vibevoice_tokenizer.py /opt/scripts/download_vibevoice_tokenizer.py
RUN set -eux; \
    case "${MODEL_ID}" in \
      # model-block:start:vibevoice-1.5b
      "vibevoice-1.5b") \
        HF_HOME=/models/hf-cache \
        HUGGINGFACE_HUB_CACHE=/models/hf-cache/hub \
        TRANSFORMERS_CACHE=/models/hf-cache/transformers \
        python /opt/scripts/download_vibevoice_tokenizer.py; \
        ;; \
      # model-block:end:vibevoice-1.5b
      # model-block:start:vibevoice-7b
      "vibevoice-7b") \
        HF_HOME=/models/hf-cache \
        HUGGINGFACE_HUB_CACHE=/models/hf-cache/hub \
        TRANSFORMERS_CACHE=/models/hf-cache/transformers \
        python /opt/scripts/download_vibevoice_tokenizer.py; \
        ;; \
      # model-block:end:vibevoice-7b
      *) \
        true; \
        ;; \
    esac

RUN set -eux; \
    case "${MODEL_ID}" in \
      # model-block:start:cosyvoice3-0.5b
      "cosyvoice3-0.5b") \
        apt-get update; \
        apt-get install -y --no-install-recommends git; \
        rm -rf /var/lib/apt/lists/*; \
        git clone --depth 1 https://github.com/FunAudioLLM/CosyVoice.git /opt/CosyVoice; \
        cd /opt/CosyVoice; \
        git submodule update --init --recursive; \
        ;; \
      # model-block:end:cosyvoice3-0.5b
      *) \
        true; \
        ;; \
    esac
